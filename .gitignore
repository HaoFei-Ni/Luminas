# ==============================================================================
# Luminas monorepo — 仓库根忽略规则
# lumina/ 内工具缓存另见 lumina/.gitignore（与 pyproject 对齐）
# ==============================================================================

# --- 构建与产物 ---
outputs/
build/
cmake-build-*/
**/CMakeFiles/
**/CMakeCache.txt
**/compile_commands.json

# --- 编辑器 / Agent 本地态（勿入库） ---
.claude/
.codex/
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- 工具缓存（根目录误跑也会生成） ---
