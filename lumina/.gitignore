# ==============================================================================
# lumina/ Python 工具链产物（非源码，不参与版本控制）
# 与 pyproject.toml 的 ruff/mypy/pytest/complexipy cache 配置一致
# ==============================================================================

# uv 虚拟环境与锁文件之外的运行时产物
.venv/

# Python 字节码缓存
__pycache__/
*.py[cod]
*$py.class

# 工具缓存：真值源 quality-gate.toml [cache]（统一 root；下列根级名为误跑兜底）
# 注意：测试源码在 tests/，勿再建 test/ 目录
.cache/
.pytest_cache/
.mypy_cache/
.hypothesis/
.ruff_cache/
.complexipy_cache/

# 质量门禁产物（tests/reports/；勿提交）
tests/reports/complexipy.json
tests/reports/quality-gate.md
tests/reports/quality-gate.json
# 兼容：旧文件名 / 根级误跑产物
tests/reports/complexipy-report.json
tests/reports/complexipy-report.md
/complexipy-report.json
/complexipy-report.md
/complexipy.json

# 覆盖率产物（pytest-cov / coverage.py）
.coverage
coverage.xml
htmlcov/

# 本地构建树（正式产物在仓库 outputs/；勿把 build/ 当成架构目录）
build/
